load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "landlock",
    srcs = [
        "enforce_pre_tsync_linux.go",
        "policy.go",
        "restrict_linux.go",
        "restrict_nonlinux.go",
    ],
    importpath = "github.com/DataDog/rshell/internal/sandbox/landlock",
    visibility = ["//:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_landlock_lsm_go_landlock//landlock/syscall",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_landlock_lsm_go_landlock//landlock/syscall",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "landlock_test",
    size = "small",
    srcs = [
        "policy_test.go",
        "race_disabled_test.go",
        "race_enabled_test.go",
        "restrict_linux_test.go",
    ],
    embed = [":landlock"],
    deps = [
        "@com_github_stretchr_testify//require",
    ] + select({
        "@rules_go//go/platform:android": [
            "@com_github_landlock_lsm_go_landlock//landlock/syscall",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_landlock_lsm_go_landlock//landlock/syscall",
        ],
        "//conditions:default": [],
    }),
)
