load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "rshell_lib",
    srcs = [
        "main.go",
        "privileged_helper_linux.go",
        "privileged_helper_unsupported.go",
        "privileged_worker_linux.go",
        "telemetry_off.go",
    ],
    importpath = "github.com/DataDog/rshell/cmd/rshell",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/interpoption",
        "//internal/version",
        "//interp",
        "@com_github_spf13_cobra//:cobra",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/sandbox/landlock",
            "//internal/sandbox/seccomp",
            "//privilegedhelper",
            "@cc_mvdan_sh_v3//syntax",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/sandbox/landlock",
            "//internal/sandbox/seccomp",
            "//privilegedhelper",
            "@cc_mvdan_sh_v3//syntax",
        ],
        "//conditions:default": [],
    }),
)

go_binary(
    name = "rshell",
    embed = [":rshell_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "rshell_test",
    srcs = [
        "main_procpath_linux_test.go",
        "main_test.go",
        "privileged_helper_linux_test.go",
        "privileged_helper_root_integration_test.go",
        "privileged_worker_linux_test.go",
    ],
    embed = [":rshell_lib"],
    deps = [
        "//interp",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ] + select({
        "@rules_go//go/platform:android": [
            "//internal/sandbox/landlock",
            "//privilegedhelper",
            "@org_golang_google_protobuf//proto",
            "@org_golang_google_protobuf//types/known/structpb",
            "@org_golang_google_protobuf//types/known/timestamppb",
        ],
        "@rules_go//go/platform:linux": [
            "//internal/sandbox/landlock",
            "//privilegedhelper",
            "@org_golang_google_protobuf//proto",
            "@org_golang_google_protobuf//types/known/structpb",
            "@org_golang_google_protobuf//types/known/timestamppb",
        ],
        "//conditions:default": [],
    }),
)
