load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "interp",
    srcs = [
        "api.go",
        "cd_support.go",
        "command_scrub.go",
        "handler.go",
        "register_builtins.go",
        "register_internal.go",
        "runner.go",
        "runner_exec.go",
        "runner_expand.go",
        "runner_redir.go",
        "runner_redir_remediation.go",
        "system_services.go",
        "systemd_target.go",
        "validate.go",
        "vars.go",
    ],
    importpath = "github.com/DataDog/rshell/interp",
    visibility = ["//visibility:public"],
    deps = [
        "//allowedpaths",
        "//builtins",
        "//builtins/awk",
        "//builtins/break",
        "//builtins/cat",
        "//builtins/cd",
        "//builtins/continue",
        "//builtins/cut",
        "//builtins/df",
        "//builtins/du",
        "//builtins/echo",
        "//builtins/exit",
        "//builtins/false",
        "//builtins/find",
        "//builtins/free",
        "//builtins/grep",
        "//builtins/head",
        "//builtins/help",
        "//builtins/ip",
        "//builtins/journalctl",
        "//builtins/jq",
        "//builtins/logrotate",
        "//builtins/ls",
        "//builtins/lsof",
        "//builtins/ping",
        "//builtins/pmap",
        "//builtins/printf",
        "//builtins/ps",
        "//builtins/pwd",
        "//builtins/read",
        "//builtins/rm",
        "//builtins/sed",
        "//builtins/sha256sum",
        "//builtins/sort",
        "//builtins/ss",
        "//builtins/stat",
        "//builtins/strings_cmd",
        "//builtins/systemctl",
        "//builtins/tail",
        "//builtins/testcmd",
        "//builtins/tr",
        "//builtins/true",
        "//builtins/truncate",
        "//builtins/uname",
        "//builtins/uniq",
        "//builtins/uptime",
        "//builtins/vmstat",
        "//builtins/wc",
        "//builtins/xargs",
        "//internal/interpoption",
        "//internal/systemd",
        "//internal/version",
        "@cc_mvdan_sh_v3//expand",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_datadog_datadog_agent_pkg_fleet_installer//telemetry",
    ],
)

go_test(
    name = "interp_test",
    size = "small",
    srcs = [
        "allowed_commands_test.go",
        "allowed_paths_internal_test.go",
        "allowed_paths_test.go",
        "builtin_ip_pentest_test.go",
        "builtin_logrotate_unix_test.go",
        "builtin_truncate_fifo_pentest_test.go",
        "builtin_truncate_pentest_test.go",
        "case_clause_vuln_hunt_test.go",
        "cd_support_test.go",
        "command_scrub_test.go",
        "comments_vuln_hunt_test.go",
        "glob_bench_test.go",
        "glob_readdir_limit_test.go",
        "globbing_vuln_hunt_test.go",
        "internal_errors_test.go",
        "journal_rotate_integration_test.go",
        "journal_vacuum_integration_test.go",
        "line_continuation_vuln_hunt_test.go",
        "logic_ops_vuln_hunt_test.go",
        "negation_vuln_hunt_test.go",
        "parser_lexer_vuln_hunt_test.go",
        "pipe_vuln_hunt_test.go",
        "readonly_test.go",
        "readonly_vuln_hunt_test.go",
        "redir_subsystem_vuln_hunt_test.go",
        "remediation_only_dispatch_test.go",
        "rm_run_budget_test.go",
        "runner_redir_remediation_test.go",
        "runner_redir_test.go",
        "runner_redir_umask_unix_test.go",
        "runner_redir_umask_windows_test.go",
        "runner_stdin_isolation_test.go",
        "selective_elevation_test.go",
        "signal_handling_vuln_hunt_test.go",
        "simple_command_vuln_hunt_test.go",
        "start_time_test.go",
        "subshell_vuln_hunt_test.go",
        "system_services_test.go",
        "systemd_target_test.go",
        "timeout_test.go",
        "tracing_test.go",
        "validate_test.go",
        "var_size_test.go",
    ],
    # keep: redir_subsystem_vuln_hunt_test.go reads runner_redir.go's own
    # source at runtime to check for a specific regression pattern.
    data = ["runner_redir.go"],
    embed = [":interp"],
    deps = [
        "//builtins",
        "//builtins/testutil",
        "//internal/interpoption",
        "//internal/version",
        "@cc_mvdan_sh_v3//expand",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_datadog_datadog_agent_pkg_fleet_installer//telemetry",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
