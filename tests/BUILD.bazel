load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "tests_test",
    size = "small",
    srcs = [
        "compliance_test.go",
        "scenarios_test.go",
    ],
    # keep: scenarios_test.go reads these YAML fixtures via a relative path at
    # runtime; gazelle only auto-detects dirs literally named "testdata".
    data = glob(["scenarios/**"]),
    deps = [
        "//internal/interpoption",
        "//interp",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)
