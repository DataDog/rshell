load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lsof",
    srcs = ["lsof.go"],
    importpath = "github.com/DataDog/rshell/builtins/lsof",
    visibility = ["//visibility:public"],
    deps = [
        "//builtins",
        "//builtins/internal/procfd",
    ],
)

go_test(
    name = "lsof_test",
    size = "small",
    srcs = [
        "lsof_fuzz_test.go",
        "lsof_test.go",
    ],
    embed = [":lsof"],
    deps = ["//builtins/internal/procfd"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
