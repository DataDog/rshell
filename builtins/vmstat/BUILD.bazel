load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "vmstat",
    srcs = ["vmstat.go"],
    importpath = "github.com/DataDog/rshell/builtins/vmstat",
    visibility = ["//visibility:public"],
    deps = [
        "//builtins",
        "//builtins/internal/procpath",
        "//builtins/internal/vmstat",
    ],
)

go_test(
    name = "vmstat_test",
    size = "small",
    srcs = ["vmstat_test.go"],
    embed = [":vmstat"],
    deps = [
        "//builtins",
        "//builtins/internal/vmstat",
        "@com_github_stretchr_testify//assert",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
