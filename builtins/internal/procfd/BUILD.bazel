load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "procfd",
    srcs = [
        "procfd.go",
        "procfd_linux.go",
        "procfd_other.go",
    ],
    importpath = "github.com/DataDog/rshell/builtins/internal/procfd",
    visibility = ["//builtins:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "procfd_test",
    size = "small",
    srcs = [
        "procfd_linux_fuzz_test.go",
        "procfd_linux_test.go",
        "procfd_other_test.go",
    ],
    embed = [":procfd"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//builtins/internal/procpath",
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "//builtins/internal/procpath",
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
