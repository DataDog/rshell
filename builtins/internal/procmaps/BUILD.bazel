load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "procmaps",
    srcs = [
        "procmaps.go",
        "procmaps_darwin.go",
        "procmaps_linux.go",
        "procmaps_other.go",
        "procmaps_windows.go",
    ],
    importpath = "github.com/DataDog/rshell/builtins/internal/procmaps",
    visibility = ["//builtins:__subpackages__"],
    deps = select({
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:windows": [
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "procmaps_test",
    size = "small",
    srcs = [
        "procmaps_darwin_test.go",
        "procmaps_linux_test.go",
        "procmaps_windows_test.go",
    ],
    embed = [":procmaps"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:darwin": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:ios": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:windows": [
            "@com_github_stretchr_testify//assert",
            "@org_golang_x_sys//windows",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
