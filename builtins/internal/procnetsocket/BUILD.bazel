load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "procnetsocket",
    srcs = [
        "procnetsocket.go",
        "procnetsocket_linux.go",
        "procnetsocket_other.go",
    ],
    importpath = "github.com/DataDog/rshell/builtins/internal/procnetsocket",
    visibility = ["//builtins:__subpackages__"],
    deps = ["//builtins/internal/procpath"],
)

go_test(
    name = "procnetsocket_test",
    size = "small",
    srcs = [
        "procnetsocket_linux_fuzz_test.go",
        "procnetsocket_linux_parse_test.go",
        "procnetsocket_linux_vuln_hunt_test.go",
        "procnetsocket_other_vuln_hunt_test.go",
        "procnetsocket_vuln_hunt_test.go",
    ],
    embed = [":procnetsocket"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
            "@com_github_stretchr_testify//require",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
