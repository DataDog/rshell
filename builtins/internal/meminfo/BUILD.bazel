load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "meminfo",
    srcs = [
        "meminfo.go",
        "meminfo_linux.go",
        "meminfo_other.go",
    ],
    importpath = "github.com/DataDog/rshell/builtins/internal/meminfo",
    visibility = ["//builtins:__subpackages__"],
)

go_test(
    name = "meminfo_test",
    size = "small",
    srcs = ["meminfo_linux_test.go"],
    embed = [":meminfo"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//assert",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//assert",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
