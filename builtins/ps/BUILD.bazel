load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ps",
    srcs = [
        "format.go",
        "ps.go",
    ],
    importpath = "github.com/DataDog/rshell/builtins/ps",
    visibility = ["//visibility:public"],
    deps = [
        "//builtins",
        "//builtins/internal/procinfo",
    ],
)

go_test(
    name = "ps_test",
    size = "small",
    srcs = [
        "format_test.go",
        "ps_procpath_linux_test.go",
        "ps_test.go",
    ],
    embed = [":ps"],
    deps = [
        "//builtins",
        "//builtins/internal/procinfo",
        "//internal/interpoption",
        "//interp",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
