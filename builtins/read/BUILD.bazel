load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "read",
    srcs = [
        "poll_other.go",
        "poll_unix.go",
        "read.go",
    ],
    importpath = "github.com/DataDog/rshell/builtins/read",
    visibility = ["//visibility:public"],
    deps = [
        "//builtins",
        "@org_golang_x_term//:term",
    ] + select({
        "@rules_go//go/platform:aix": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:dragonfly": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:freebsd": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:illumos": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:js": [
            "//builtins/internal/winpoll",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:netbsd": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:openbsd": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:osx": [
            "//builtins/internal/winpoll",
        ],
        "@rules_go//go/platform:plan9": [
            "//builtins/internal/winpoll",
        ],
        "@rules_go//go/platform:qnx": [
            "//builtins/internal/winpoll",
        ],
        "@rules_go//go/platform:solaris": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:windows": [
            "//builtins/internal/winpoll",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "read_test",
    size = "small",
    srcs = [
        "read_internal_test.go",
        "read_vuln_hunt_test.go",
    ],
    embed = [":read"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
