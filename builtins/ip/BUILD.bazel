load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "ip",
    srcs = ["ip.go"],
    importpath = "github.com/DataDog/rshell/builtins/ip",
    visibility = ["//visibility:public"],
    deps = [
        "//builtins",
        "//builtins/internal/procnetroute",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
