load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sed",
    srcs = [
        "engine.go",
        "parser.go",
        "sed.go",
        "types.go",
    ],
    importpath = "github.com/DataDog/rshell/builtins/sed",
    visibility = ["//visibility:public"],
    deps = ["//builtins"],
)

go_test(
    name = "sed_test",
    size = "small",
    srcs = [
        "engine_test.go",
        "sed_vuln_hunt_test.go",
    ],
    embed = [":sed"],
    deps = [
        "//builtins/testutil",
        "//internal/interpoption",
        "//interp",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
