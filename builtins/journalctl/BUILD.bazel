load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "journalctl",
    srcs = ["journalctl.go"],
    importpath = "github.com/DataDog/rshell/builtins/journalctl",
    visibility = ["//visibility:public"],
    deps = [
        "//builtins",
        "//builtins/internal/sizeparse",
    ],
)

go_test(
    name = "journalctl_test",
    srcs = ["journalctl_test.go"],
    embed = [":journalctl"],
    deps = [
        "//builtins",
        "@com_github_spf13_pflag//:pflag",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
