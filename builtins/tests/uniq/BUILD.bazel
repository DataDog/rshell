load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "uniq_test",
    size = "small",
    srcs = ["uniq_fuzz_test.go"],
    data = glob(["testdata/**"]),
    deps = ["//builtins/testutil"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
