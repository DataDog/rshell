load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "xargs_test",
    size = "small",
    srcs = [
        "helpers_test.go",
        "xargs_fuzz_test.go",
    ],
    deps = [
        "//builtins/testutil",
        "//interp",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
