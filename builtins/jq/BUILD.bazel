load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "jq",
    srcs = [
        "eval.go",
        "jq.go",
        "lexer.go",
        "parser.go",
        "surrogate.go",
        "value.go",
    ],
    importpath = "github.com/DataDog/rshell/builtins/jq",
    visibility = ["//visibility:public"],
    deps = ["//builtins"],
)

go_test(
    name = "jq_test",
    size = "small",
    srcs = [
        "fuzz_test.go",
        "jq_test.go",
        "value_test.go",
    ],
    embed = [":jq"],
    deps = [
        "//builtins",
        "@com_github_spf13_pflag//:pflag",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
