load("@bazel_skylib//lib:subpackages.bzl", "subpackages")
load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "testcmd",
    srcs = ["testcmd.go"],
    importpath = "github.com/DataDog/rshell/builtins/testcmd",
    visibility = ["//visibility:public"],
    deps = ["//builtins"],
)

go_test(
    name = "testcmd_test",
    size = "small",
    srcs = [
        "testcmd_gnu_compat_test.go",
        "testcmd_pentest_test.go",
        "testcmd_test.go",
        "testcmd_unix_test.go",
        "testcmd_vuln_hunt_test.go",
        "testcmd_windows_test.go",
    ],
    deps = [
        "//builtins/testutil",
        "//internal/interpoption",
        "//interp",
        "@cc_mvdan_sh_v3//syntax",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]) + [
        "%s:srcs" % d
        for d in subpackages.all(
            allow_empty = True,
            fully_qualified = True,
        )
    ],
    visibility = ["//visibility:public"],
)
