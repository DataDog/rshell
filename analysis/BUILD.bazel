load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "analysis",
    srcs = [
        "analyzer.go",
        "structural.go",
        "symbols_allowedpaths.go",
        "symbols_builtins.go",
        "symbols_common.go",
        "symbols_fsstat.go",
        "symbols_internal.go",
        "symbols_interp.go",
    ],
    importpath = "github.com/DataDog/rshell/analysis",
    visibility = ["//visibility:public"],
    deps = ["@org_golang_x_tools//go/analysis"],
)

go_test(
    name = "analysis_test",
    srcs = [
        "analyzer_test.go",
        "callctx_openfile_vuln_hunt_test.go",
        "signal_handling_vuln_hunt_test.go",
        "structural_test.go",
        "symbols_allowedpaths_test.go",
        "symbols_allowedpaths_verification_test.go",
        "symbols_builtins_test.go",
        "symbols_builtins_verification_test.go",
        "symbols_fsstat_test.go",
        "symbols_fsstat_verification_test.go",
        "symbols_interp_test.go",
        "symbols_interp_verification_test.go",
        "symbols_test.go",
        "symbols_verification_test.go",
    ],
    embed = [":analysis"],
    # keep: these tests copy the live interp/, builtins/, and allowedpaths/
    # source trees (including their gazelle-owned subpackages) at runtime to
    # re-lint them. That's incompatible with Bazel's per-package sandboxing;
    # run with `go test ./analysis/...` instead.
    tags = ["manual"],
    deps = [
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
        "@org_golang_x_tools//go/analysis/analysistest",
    ],
)
